# Environment Variable Template for AUREX Deployment
# Copy to .env for local Docker Compose or production overrides.
# DO NOT commit .env files containing real secrets to version control.

# ---------------------------------------------------------------
# Server & Port Configuration
# ---------------------------------------------------------------
PORT=8080
FRONTEND_PORT=80

# ---------------------------------------------------------------
# Active Spring Profile
# ---------------------------------------------------------------
# - 'prod' → Recommended for containerized deployment (schema init never, Swagger off).
# - 'dev'  → Development profile with automatic schema recreation.
SPRING_PROFILES_ACTIVE=prod
ENABLE_SWAGGER=false

# ---------------------------------------------------------------
# PostgreSQL Database Configuration
# ---------------------------------------------------------------
POSTGRES_DB=financial_audit
DB_USERNAME=postgres
# REQUIRED — Strong database password.
# docker-compose will fail if unset.
DB_PASSWORD=replace_with_a_strong_database_password

# ---------------------------------------------------------------
# JWT Security Configuration
# ---------------------------------------------------------------
# REQUIRED — Minimum 32 characters long.
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_secure_secret_of_at_least_32_chars
JWT_EXPIRATION=86400

# ---------------------------------------------------------------
# Production Initial Administrator Provisioning (First-Run Only)
# ---------------------------------------------------------------
# To create the initial administrator on a fresh production database:
# 1. Supply a strong password (minimum 12 characters).
# 2. Start the platform: docker compose up -d
# 3. Log in through the UI with username 'admin' and this password.
# 4. REMOVE this password from your .env file and restart.
# If user table already has accounts, this variable is safely ignored.
AUREX_PROD_INITIAL_ADMIN_PASSWORD=
AUREX_PROD_INITIAL_ADMIN_USERNAME=admin

# ---------------------------------------------------------------
# Development Admin Bootstrap (Dev profile only, ignored in prod)
# ---------------------------------------------------------------
AUREX_SEED_ADMIN_ENABLED=false
AUREX_DEV_ADMIN_PASSWORD=

# ---------------------------------------------------------------
# CORS & Frontend Origins
# ---------------------------------------------------------------
# Comma-separated list of allowed origins.
# For Nginx reverse-proxy deployment on port 80: http://localhost,http://localhost:80
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------
# Frontend Build Environment Variables (Vite)
# ---------------------------------------------------------------
# Default is same-origin '/api' for Docker Compose Nginx deployment.
VITE_API_BASE_URL=/api
