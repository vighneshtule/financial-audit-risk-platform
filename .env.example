# Environment Variable Template for AUREX Deployment
# Copy to .env for local overrides or configure in your deployment platform (e.g. Docker / Render / AWS / Kubernetes)

# Server Configuration
PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/financial_audit
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Security & CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Active Spring Profile
# - 'dev'  → local/Docker development (DevAdminBootstrap can seed the first admin).
#            This is the new default when running docker compose locally.
# - 'prod' → production deployment (admin seeding blocked, JWT_SECRET strictly validated).
#            Set explicitly when deploying to production:  SPRING_PROFILES_ACTIVE=prod
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------
# JWT Security Configuration
# ---------------------------------------------------------------
# REQUIRED — both for docker-compose (backend service) and bare-metal production.
# docker-compose will refuse to start if this is unset (uses the :? operator).
# Production Spring Boot startup will also fail if this is missing or uses the dev default.
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_secure_secret_of_at_least_32_chars

# Token expiry in seconds (default: 86400 = 24 hours)
JWT_EXPIRATION=86400

# ---------------------------------------------------------------
# Dev Admin Bootstrap Configuration
# ---------------------------------------------------------------
# Disabled by default. Set to true ONLY in local development.
# Never enable in production (seeding is blocked in the prod profile).
AUREX_SEED_ADMIN_ENABLED=false

# REQUIRED when AUREX_SEED_ADMIN_ENABLED=true.
# There is NO default — startup will fail if seeding is enabled without this value.
# Use a strong password even in development to build good habits.
AUREX_DEV_ADMIN_PASSWORD=

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
