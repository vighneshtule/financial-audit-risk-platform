# Environment Variable Template for AUREX Deployment
# Copy to .env for local overrides or configure in your deployment platform (e.g. Docker / Render / AWS / Kubernetes)

# Server Configuration
PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/financial_audit
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Security & CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Active Spring Profile (e.g., prod or default)
SPRING_PROFILES_ACTIVE=default

# Swagger UI Control
ENABLE_SWAGGER=true

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
